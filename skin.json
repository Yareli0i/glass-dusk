    "Transitions": {
      "description": "Opening another game: the accent flows from the old colour to the new one and the art behind the glass fades over. Instant changes both at once.",
      "tab": "Look",
      "default": "Flowing",
      "values": {
        "Flowing": {},
        "Instant": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "css/options/motion-off.css"
          }
        }
      }
    },
    "Sign-in screen": {
      "description": "The account chooser when Steam starts (Who's playing?): the art of the game you played last, the covers of your own games drifting past, the art of your games one after another, plain dusk or Steam's wall of covers, each with the theme's glass, or Steam's own look. It shows only if Steam asks which account to use.",
      "tab": "Look",
      "default": "Game art",
      "values": {
        "Game art": {},
        "Your games": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "css/options/login-games.css"
          }
        },
        "Slideshow": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "css/options/login-slides.css"
          }
        },
        "Dusk": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "css/options/login-dusk.css"
          }
        },
        "Steam's wall": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "css/options/login-wall.css"
          }
        },
        "Steam": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "css/options/login-steam.css"
          }
        }
      }
    },
    "When idle": {
      "description": "Left alone on the library, Steam becomes the art of the game in view, with its logo, the time and the date; the first move brings everything back. Never while something is downloading or a video is playing.",
      "tab": "Look",
      "default": "After 5 minutes",
      "values": {
        "After 5 minutes": {},
        "After 2 minutes": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/still-2.css"
          }
        },
        "After 15 minutes": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/still-15.css"
          }
        },
        "Never": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/still-off.css"
          }
        }
      }
    },
    "Library home": {
      "description": "The theme's header (greeting, stats, Continue) or Steam's shelves only.",
