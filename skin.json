      "default": "Transparent",
      "values": {
        "Transparent": {},
        "Steam": {
          "TargetCss": {
            "affects": [
              "^SP Overlay"
            ],
            "src": "css/options/overlay-steam.css"
          }
        }
      }
    },
    "Overlay panels": {
      "description": "Game Overview, browser and toolbar: smoked glass or Steam's own.",
      "tab": "Big Picture & overlay",
      "default": "Glass",
      "values": {
        "Glass": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "css/options/overlay-glass.css"
          }
        },
        "Steam": {}
      }
    },
    "Plugins": {
      "description": "Millennium plugins that draw their own interface (HLTB for Steam, Achievement Groups, Player Count, Extendium): in the theme's colours, or as the plugin ships them.",
      "tab": "Plugins",
      "default": "Theme",
      "values": {
        "Theme": {
          "TargetCss": {
            "affects": [".*"],
            "src": "css/plugins.css"
          }
        },
        "Plugin's own": {}
      }
    }
  },
  "Patches": [
    {
      "MatchRegexString": "^Steam$",
      "TargetCss": "css/steam.css"
    },
    {
      "MatchRegexString": ".*",
      "TargetCss": "css/shared.css"
    },
    {
      "MatchRegexString": ".*",
      "TargetJs": "js/dusk.js"
    },
    {
      "MatchRegexString": "^SP Overlay",
      "TargetCss": "css/overlay.css"
    }
  ]
}
