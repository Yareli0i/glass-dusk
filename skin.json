{
  "name": "Glass Dusk",
  "description": "Smoked glass over the art of the game you have open: the client takes its accent colour from that art. Styles the library, store, menus, Big Picture and the in-game overlay.",
  "author": "Yareli",
  "version": "1.4.0",
  "tags": [
    "Dark",
    "Glass",
    "Dynamic",
    "Big Picture"
  ],
  "github": {
    "owner": "Yareli0i",
    "repo_name": "glass-dusk"
  },
  "funding": {
    "kofi": "yareli0i"
  },
  "header_image": "https://raw.githubusercontent.com/Yareli0i/glass-dusk/main/images/header.jpg",
  "splash_image": "https://raw.githubusercontent.com/Yareli0i/glass-dusk/main/images/splash.jpg",
  "Steam-WebKit": "css/webkit.css",
  "RootColors": "css/root.css",
  "Conditions": {
    "Theme language": {
      "description": "Text the theme draws itself: home header, Big Picture chip, dates.",
      "tab": "Look",
      "default": "English",
      "values": {
        "English": {},
        "Українська": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "css/options/lang-uk.css"
          }
        }
      }
    },
    "Background": {
      "description": "What sits behind the glass.",
      "tab": "Look",
      "default": "Game art",
      "values": {
        "Game art": {},
        "Meadow": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/bg-meadow.css"
          }
        },
        "Plain dusk": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/bg-plain.css"
          }
        }
      }
    },
    "Background art": {
      "description": "How strongly the game art shows through.",
      "tab": "Look",
      "default": "Normal",
      "values": {
        "Normal": {},
        "Subtle": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "css/options/art-subtle.css"
          }
        },
        "Vivid": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "css/options/art-vivid.css"
          }
        }
      }
    },
    "Accent colour": {
      "description": "Colour of buttons and highlights. Fixed uses Accent from the Colors tab.",
      "tab": "Look",
      "default": "Game art",
      "values": {
        "Game art": {},
        "Fixed": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "css/options/accent-fixed.css"
          }
        }
      }
    },
    "Glass": {
      "description": "How see-through the panels are.",
      "tab": "Look",
      "default": "Normal",
      "values": {
        "Normal": {},
        "Denser": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/glass-dense.css"
          }
        },
        "Sheerer": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/glass-sheer.css"
          }
        }
      }
    },
    "Corners": {
      "description": "Radius of panels and cards.",
      "tab": "Look",
      "default": "Normal",
      "values": {
        "Normal": {},
        "Softer": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "css/options/radius-soft.css"
          }
        },
        "Sharper": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "css/options/radius-sharp.css"
          }
        }
      }
    },
    "Library home": {
      "description": "The theme's header (greeting, stats, Continue) or Steam's shelves only.",
      "tab": "Library",
      "default": "Theme",
      "values": {
        "Theme": {},
        "Steam": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/home-steam.css"
          }
        }
      }
    },
    "What's New shelf": {
      "description": "Steam's What's New shelf on the library home.",
      "tab": "Library",
      "default": "no",
      "values": {
        "no": {},
        "yes": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/whatsnew-show.css"
          }
        }
      }
    },
    "Game list side": {
      "description": "Where the game list sits.",
      "tab": "Library",
      "default": "Right",
      "values": {
        "Right": {},
        "Left": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/list-left.css"
          }
        }
      }
    },
    "Big Picture": {
      "description": "Cover: the focused game's art fills the screen and lends its colour.",
      "tab": "Big Picture & overlay",
      "default": "Cover",
      "values": {
        "Cover": {
          "TargetCss": {
            "affects": [
              "GamepadUIPopupWindowBody"
            ],
            "src": "css/bigpicture.css"
          }
        },
        "Steam": {}
      }
    },
    "Big Picture hours chip": {
      "description": "Top-left chip: logo, hours played, last played.",
      "tab": "Big Picture & overlay",
      "default": "yes",
      "values": {
        "yes": {},
        "no": {
          "TargetCss": {
            "affects": [
              "GamepadUIPopupWindowBody"
            ],
            "src": "css/options/bpm-chip-hide.css"
          }
        }
      }
    },
    "Overlay background": {
      "description": "Behind the Shift+Tab panels: a light veil or Steam's dark sheet.",
      "tab": "Big Picture & overlay",
      "default": "Transparent",
      "values": {
        "Transparent": {},
        "Steam": {
          "TargetCss": {
            "affects": [
              "^SP Overlay"
            ],
            "src": "css/options/overlay-steam.css"
          }
        }
      }
    },
    "Overlay panels": {
      "description": "Game Overview, browser and toolbar: smoked glass or Steam's own.",
      "tab": "Big Picture & overlay",
      "default": "Glass",
      "values": {
        "Glass": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "css/options/overlay-glass.css"
          }
        },
        "Steam": {}
      }
    }
  },
  "Patches": [
    {
      "MatchRegexString": "^Steam$",
      "TargetCss": "css/steam.css"
    },
    {
      "MatchRegexString": ".*",
      "TargetCss": "css/shared.css"
    },
    {
      "MatchRegexString": ".*",
      "TargetJs": "js/dusk.js"
    },
    {
      "MatchRegexString": "^SP Overlay",
      "TargetCss": "css/overlay.css"
    }
  ]
}
