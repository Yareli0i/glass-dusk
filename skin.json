    "Big Picture": {
      "description": "Cover: the focused game's art fills the screen and lends its colour.",
      "tab": "Big Picture & overlay",
      "default": "Cover",
      "values": {
        "Cover": {
          "TargetCss": {
            "affects": [
              "GamepadUIPopupWindowBody"
            ],
            "src": "css/bigpicture.css"
          }
        },
        "Steam": {}
      }
    },
    "Big Picture home": {
      "description": "Big art: the focused game's art, sharp, across the whole first screen with the carousel at its foot, as in Steam's Big Art Mode, whether or not that setting of Steam's (Settings → Home) is on. Steam's: the layout is left to that setting, over the theme's softened art.",
      "tab": "Big Picture & overlay",
      "default": "Big art",
      "values": {
        "Big art": {},
        "Steam's": {
          "TargetCss": {
            "affects": [
              "GamepadUIPopupWindowBody"
            ],
            "src": "css/options/bpm-home-steam.css"
          }
        }
      }
    },
