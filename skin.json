      "description": "The focused game's numbers under the carousel, beside Steam's own label: time played, last played, achievements.",
      "tab": "Big Picture & overlay",
      "default": "yes",
      "values": {
        "yes": {},
        "no": {
          "TargetCss": {
            "affects": [
              "GamepadUIPopupWindowBody"
            ],
            "src": "css/options/bpm-chip-hide.css"
          }
