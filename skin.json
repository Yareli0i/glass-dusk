{
  "name": "Glass Dusk",
  "description": "Smoked glass over the art of the game you have open: the client takes its accent colour from that art. Styles the library, store, menus, Big Picture and the in-game overlay.",
  "author": "Yareli",
  "version": "2.0.3",
  "tags": [
    "Dark",
    "Glass",
    "Dynamic",
    "Big Picture"
  ],
  "github": {
    "owner": "Yareli0i",
    "repo_name": "glass-dusk"
  },
  "funding": {
    "kofi": "yareli0i"
  },
  "header_image": "https://raw.githubusercontent.com/Yareli0i/glass-dusk/main/images/header.jpg",
  "splash_image": "https://raw.githubusercontent.com/Yareli0i/glass-dusk/main/images/splash.jpg",
  "Steam-WebKit": "css/webkit.css",
  "RootColors": "css/root.css",
  "Conditions": {
    "Wallet balance": {
      "description": "The balance in the top bar. Blurred, it shows when you point at it.",
      "tab": "Look",
      "default": "Show",
      "values": {
        "Show": {},
        "Blur until hover": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "css/options/wallet-blur.css"
          }
        }
      }
    },
    "Theme language": {
      "description": "Text the theme draws itself: home header, Big Picture chip, dates.",
      "tab": "Look",
      "default": "English",
      "values": {
        "English": {},
        "Українська": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "css/options/lang-uk.css"
          }
        },
        "Français": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "css/options/lang-fr.css"
          }
        }
      }
    },
    "Background": {
      "description": "What sits behind the glass.",
      "tab": "Look",
      "default": "Game art",
      "values": {
        "Game art": {},
        "Meadow": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/bg-meadow.css"
          }
        },
        "Plain dusk": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/bg-plain.css"
          }
        }
      }
    },
    "Background art": {
      "description": "How strongly the game art shows through.",
      "tab": "Look",
      "default": "Normal",
      "values": {
        "Normal": {},
        "Subtle": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "css/options/art-subtle.css"
          }
        },
        "Vivid": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "css/options/art-vivid.css"
          }
        }
      }
    },
    "Accent colour": {
      "description": "Colour of buttons and highlights. Game art: the colours of the game in view, and with none in view (store, community) the last one's. Fixed uses Accent from the Colors tab.",
      "tab": "Look",
      "default": "Game art",
      "values": {
        "Game art": {},
        "Fixed": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "css/options/accent-fixed.css"
          }
        }
      }
    },
    "Accent style": {
      "description": "Two-tone takes a second colour from the game art, close to the first and as bright, and runs the main buttons and the progress bars from one to the other. Solid is one colour.",
      "tab": "Look",
      "default": "Two-tone",
      "values": {
        "Two-tone": {},
        "Solid": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "css/options/accent-solid.css"
          }
        }
      }
    },
    "Glass": {
      "description": "How see-through the panels are.",
      "tab": "Look",
      "default": "Normal",
      "values": {
        "Normal": {},
        "Denser": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/glass-dense.css"
